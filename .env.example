# ---------------------------------------------------------------------------
# Final Trade Intelligence Platform — environment template
# Copy to .env for local development. NEVER commit real secrets.
# All variables are validated at startup (see src/final_trades/config.py).
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Local development default (durable SQLite file):
DATABASE_URL=sqlite:///data/final_trades.sqlite3
# Production example (Postgres, e.g. Neon free tier):
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# API server ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed CORS origins. Keep same-origin in production.
API_CORS_ORIGINS=http://localhost:5173
# Rate limiting: sustained requests/second and burst size per client IP.
RATE_LIMIT_RPS=1
RATE_LIMIT_BURST=30
# Seconds to cache the /overview summary response.
OVERVIEW_CACHE_TTL_SECONDS=60
# Statement timeout for public API queries (milliseconds; Postgres only).
DB_QUERY_TIMEOUT_MS=5000

# Collector -----------------------------------------------------------------
# Minimum seconds between outbound requests to the same host (politeness).
HTTP_MIN_REQUEST_INTERVAL_SECONDS=2.0
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=final-trades-collector/0.1 (+https://github.com/CHANGE-ME/final-trades; open-source research project)
# Max historical dates processed per scheduled run (backlog quota).
BACKLOG_MAX_DATES_PER_RUN=40
# Share of the per-run date budget reserved for current-day collection (0-1).
CURRENT_DAY_CAPACITY_SHARE=0.6
# Historical window for backfill (inclusive).
BACKFILL_START_DATE=2025-10-25
BACKFILL_END_DATE=2026-10-25

# Market data ---------------------------------------------------------------
# Provider for daily prices: stooq | yfinance (see docs/DECISIONS.md)
MARKET_DATA_PROVIDER=stooq
# Benchmark symbol for relative performance.
BENCHMARK_SYMBOL=SPY

# Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
